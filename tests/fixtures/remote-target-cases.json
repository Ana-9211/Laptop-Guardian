{
  "note": "Run through netguard.refuseRemote (tests/netposture.test.js) and Test-RemoteTarget (tests/NetworkActions.Tests.ps1). 'expect' is 'ok' or a phrase that must appear in the refusal.",
  "identity": ["192.168.1.1", "1.1.1.1"],
  "cases": [
    { "text": "203.0.113.5", "expect": "ok" },
    { "text": "198.51.100.0/24", "expect": "ok" },
    { "text": "2001:db8::1", "expect": "ok" },
    { "text": "127.0.0.1", "expect": "Loopback" },
    { "text": "127.5.5.5", "expect": "Loopback" },
    { "text": "127.0.0.0/8", "expect": "Loopback" },
    { "text": "::1", "expect": "Loopback" },
    { "text": "::ffff:127.0.0.1", "expect": "Loopback" },
    { "text": "::ffff:7f00:1", "expect": "Loopback" },
    { "text": "::ffff:127.9.9.9", "expect": "Loopback" },
    { "text": "0:0:0:0:0:ffff:7f00:1", "expect": "Loopback" },
    { "text": "::127.0.0.1", "expect": "Loopback" },
    { "text": "::ffff:0.0.0.0", "expect": "unspecified" },
    { "text": "::ffff:224.0.0.1", "expect": "Multicast" },
    { "text": "::ffff:169.254.1.1", "expect": "Link-local" },
    { "text": "::ffff:192.168.1.1", "expect": "normal a.b.c.d form" },
    { "text": "::ffff:203.0.113.5", "expect": "normal a.b.c.d form" },
    { "text": "::203.0.113.5", "expect": "normal a.b.c.d form" },
    { "text": "192.168.1.1", "expect": "gateway" },
    { "text": "192.168.1.0/24", "expect": "gateway" },
    { "text": "0.0.0.0", "expect": "unspecified" },
    { "text": "224.0.0.5", "expect": "Multicast" },
    { "text": "169.254.9.9", "expect": "Link-local" },
    { "text": "10.0.0.0/4", "expect": "too broad" },
    { "text": "0.0.0.0/0", "expect": "too broad" },
    { "text": "nope", "expect": "not a valid" },
    { "text": "999.1.1.1", "expect": "not a valid" }
  ]
}
