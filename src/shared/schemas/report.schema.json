    "processes":{"type":"object","required":["total","flagged","persistent","highResource","topCpu","topMemory"]},
    "cleanup":{"type":"object","required":["performed","safeMode","items","totalFreedMB"]},
    "windowsHealth":{"type":"object","required":["pendingReboot","windowsUpdate","eventErrors","sfc","dism"]}}},
  "recommendations":{"type":"array"},"actions":{"type":"array"},"errors":{"type":"array"},"ai":{"type":"object","required":["enabled","used"]}}}
