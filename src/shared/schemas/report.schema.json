{"$schema":"http://json-schema.org/draft-07/schema#","title":"Report","type":"object",
 "required":["schema","type","id","generatedAt","durationSec","status","healthScore","host","summary","sections","recommendations","actions","errors","ai"],
 "properties":{
  "schema":{"enum":["guardian.report/1"]},"type":{"enum":["daily","weekly"]},"id":{"type":"string"},"status":{"enum":["complete","partial","failed"]},
