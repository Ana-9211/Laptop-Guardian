{"$schema":"http://json-schema.org/draft-07/schema#","title":"ActionEvent","type":"object",
 "required":["id","ts","category","severity","action","result","actor"],
 "properties":{
  "id":{"type":"string"},"ts":{"type":"string"},
  "category":{"enum":["scan","process","ai","file","cleanup","defender","windows","policy","shutdown","config","system"]},
  "severity":{"enum":["info","warning","error"]},"action":{"type":"string"},"target":{"type":["string","null"]},
  "result":{"enum":["success","failure","skipped","timeout","started"]},
  "actor":{"enum":["agent","user","policy","ai-validator"]},
  "reason":{"type":["string","null"]},"relatedRecommendation":{"type":["string","null"]},"error":{"type":["string","null"]},"runType":{"type":["string","null"]}}}
